<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachability_cli</name>
  <version>0.1.0</version>
  <description>Offline reachability CLI using MoveIt Core.</description>
  <maintainer email="solegua@example.com">solegua</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_kinematics</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>random_numbers</depend>
  <depend>urdf</depend>
  <depend>srdfdom</depend>
  <depend>yaml-cpp</depend>
  <build_depend>libhdf5-dev</build_depend>
  <exec_depend>libhdf5-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
